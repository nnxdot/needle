<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Music keeps playing with the screen off or another app open. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Needle's folder shows in the Files app and in Finder, for adding music. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Music</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Needle connects to Needle on your computer and to music servers on your home network.</string>
	<!-- Covers from Needle on the computer come over the home network, without HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Needle reads the QR code of the phone remote on your computer.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- CarPlay: Needle's lists and the car's Now Playing (CarPlay.swift). The car shows Needle
	     only in builds signed with Apple's CarPlay audio entitlement. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Links from the widgets and Siri: needle://album?id=… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fyi.nnx.needle</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>needle</string>
			</array>
		</dict>
		<!-- Discord's sign-in comes back here (Settings › Discord). -->
		<dict>
			<key>CFBundleURLName</key>
			<string>fyi.nnx.needle.discord</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>discord-1552097597454295110</string>
			</array>
		</dict>
	</array>
	<!-- Discord's library checks for the Discord app, to sign in there. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>discord</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
