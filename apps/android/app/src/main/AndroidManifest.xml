<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lyrics from LRCLIB (when on), scrobbling, and signing in to Last.fm and ListenBrainz. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Asked only when someone edits tags or tidies files (Fix my library). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Reading music files on the phone. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Covers kept beside the songs (cover.jpg, and moving ones such as cover.mp4): Android 13
         and newer ask about pictures and videos apart from music. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Playing in the background, with the player in the notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A short buzz when a shake adds 10 minutes to the sleep timer. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The alarm (wake up to music): exact, and set again after the phone starts. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Whether the network is mobile data (metered), for moving covers on mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Finding speakers (Chromecast, DLNA, AirPlay) on the Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Installing an update of Needle, after Android asks the person. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Reading the library shows as a live update (Android 16 and newer). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Discord's library (for the Discord status) asks for these for voice chat and Discord
         sign-in, which Needle does not use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

    <!-- Android TV and Google TV: Needle works with a remote, so it needs no touch screen. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Finding speakers asks for Wi-Fi multicast, which would otherwise make Wi-Fi required and
         hide Needle from TV boxes on a cable. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".NeedleApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.Needle"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">
        <!-- Plain http is for the home network: a Navidrome server, Needle on a computer,
             and speakers, which have no certificates. -->
        <activity android:name="com.discord.socialsdk.AuthenticationActivity" tools:node="remove" />
        <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Needle.Starting"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|layoutDirection|locale|colorMode|fontWeightAdjustment"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- In a TV's list of apps. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- "Open with Needle" for music files. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A long press on the Quick Settings tile opens its setting. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- A Wear OS watch's presses (play, pause, skip, the heart, the volume). -->
        <service
            android:name=".NeedleWearService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/needle"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Hands a downloaded update to Android's installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Covers for the lock screen, the notification, and Android Auto (read-only). -->
        <provider
            android:name=".ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />

        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Home screen widgets. -->
        <!-- The Quick Settings tile: Play and Pause from the shade. -->
        <service
            android:name=".NeedleTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Needle"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Wake up to music: the alarm and its notification's buttons. -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <!-- Sets the alarm again after a restart: off until an alarm is on, so a restart does
             not start Needle for nothing. -->
        <receiver android:name=".AlarmBootReceiver" android:exported="false" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".NowPlayingReceiver" android:exported="true" android:label="Needle: now playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now_playing" />
        </receiver>
        <receiver android:name=".RecentReceiver" android:exported="true" android:label="Needle: recently added">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_recent" />
        </receiver>

        <!-- Android Auto: Needle is a media app there. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
