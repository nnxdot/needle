---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { Image } from "astro:assets";
import winHome from "../assets/shots2/win-home.webp";
import winAlbums from "../assets/shots2/win-albums.webp";
import winArtists from "../assets/shots2/win-artists.webp";
import winCrate from "../assets/shots2/win-crate.webp";
import winNumbers from "../assets/shots2/win-numbers.webp";
import winBig from "../assets/shots2/win-big.webp";
import winButtons from "../assets/shots2/win-buttons.webp";
import phoneHome from "../assets/shots2/phone-home.webp";
import phonePlayer from "../assets/shots2/phone-player.webp";
import phoneLyrics from "../assets/shots2/phone-lyrics.webp";
import phoneAlbum from "../assets/shots2/phone-album.webp";
import appMac from "../assets/shots2/mac-home.webp";
import shotIphone from "../assets/shots2/ios-player.webp";
import { release } from "../lib/release.js";
import { cover } from "../lib/albums.js";
import "../styles/home.css";

const { files, sizes, version, macVersion, androidVersion, iphoneVersion } = release();
const source = "https://needle.nnx.fyi/sidestore.json";
const href = (kind: string) => `/download/${files[kind]}`;
const size = (kind: string) => sizes[kind] ?? "";

// The six rules every Needle follows in 2.0.
const rules = [
  ["play-circle", "The player floats", "One rounded bar of glass over the foot of the page."],
  ["sidebar-simple", "So does the panel", "The queue, lyrics, and details sit in a pane of their own."],
  ["drop-half", "One quiet background", "No lines between the parts. Only your music has colour."],
  ["palette", "The cover's colours", "Each album and artist page takes the colours of its cover."],
  ["text-t", "Big titles, small text", "Clear names you can read across the room."],
  ["frame-corners", "Soft corners", "Covers with round corners and a shadow. Artists in circles."],
];

// The mood map: each song a dot, calm to lively and dark to bright. Made up, but always the same.
const dots = Array.from({ length: 64 }, (_, i) => {
  const a = Math.sin(i * 12.9898) * 43758.5453;
  const b = Math.sin(i * 78.233) * 12345.6789;
  const x = 8 + (a - Math.floor(a)) * 84;
  const y = 10 + (b - Math.floor(b)) * 80;
  const hue = x > 55 && y < 50 ? "var(--amber)" : "var(--fog)";
  return { x, y, hue, r: 1.2 + ((i * 7) % 5) * .25 };
});

// Smart mixes: one song's beats running into the next one's, in step.
const beats = Array.from({ length: 32 }, (_, i) => 10 + Math.round(Math.abs(Math.sin(i * 1.3) * Math.cos(i * .37)) * 34) + (i % 4 === 0 ? 10 : 0));

// The waveform seek bar, drawn from a made-up song.
const wave = Array.from({ length: 72 }, (_, i) => 6 + Math.round(Math.abs(Math.sin(i * .9) * Math.cos(i * .21) + Math.sin(i * .13) * .5) * 22));

const formats = ["FLAC", "ALAC", "WAV", "AIFF", "MP3", "AAC", "Ogg Vorbis", "Opus", "WavPack", "Monkey's Audio", "DSD", "CUE sheets", "Dolby Atmos"];
const groups = [
  { icon: "equalizer", title: "Sound", text: "Gapless playback, crossfade, smart mixes, ReplayGain, a parametric equalizer, and stems. Exclusive output for your DAC." },
  { icon: "speaker-hifi", title: "Speakers and servers", text: "Chromecast, AirPlay, and DLNA, one or several in step. Navidrome and other Subsonic servers are built in." },
  { icon: "microphone-stage", title: "Lyrics and your library", text: "Timed lyrics from your files or LRCLIB. Smart playlists, merged duplicates, and your year in music." },
  { icon: "sparkle", title: "Make it yours", text: "Themes, plugins, fonts, and the player's buttons. Discord status, media keys, and a phone remote." },
];

const platforms = [
  { id: "windows", name: "Windows", icon: "windows-logo" },
  { id: "mac", name: "Mac", icon: "apple-logo" },
  { id: "linux", name: "Linux", icon: "linux-logo" },
  { id: "android", name: "Android", icon: "android-logo" },
  { id: "iphone", name: "iPhone", icon: "device-mobile" },
];
---
<Base
  title="Needle | A music player for the music you own"
  description="Needle 2.0 is a fast, private music player for Windows, macOS, Linux, Android, and iPhone. One calm look everywhere, a visualizer, lyrics word by word, and the record crate."
  path="/"
  home
>
<main id="main">

  <!-- The first view: a soft amber light from above, the icon, and the app under it. -->
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="halo" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <a class="badge" href="#new" data-rise>
        <span class="badge-tag">2.0</span><span>A new look on every system</span><Icon name="arrow-right" weight="bold" />
      </a>
      <div class="hero-icon" data-rise><Logo /></div>
      <h1 id="hero-title" data-rise>Your music, <span class="em">in its place.</span></h1>
      <p class="hero-sub" data-rise>A fast, private music player for the songs you own. One calm look on Windows, Mac, Linux, Android, and iPhone.</p>
      <div class="hero-actions" data-rise>
        <a class="btn btn-primary" href="#download" data-os-cta><Icon name="download-simple" weight="bold" /><span data-os-label>Download Needle</span></a>
      </div>
    </div>

    <div class="stage" data-stage>
      <figure class="frame frame-hero" data-stage-shot>
        <Image src={winHome} widths={[720, 1080, 1396]} sizes="(max-width: 1240px) 94vw, 1160px" loading="eager" alt="Needle 2.0 on Windows: Home with a greeting and the song playing, the queue in a floating pane, and the player floating over the foot of the page." />
      </figure>
    </div>
  </section>

  <!-- Where Needle runs. -->
  <div class="systems" aria-label="Systems">
    <ul class="meta wrap">
      <li><Icon name="windows-logo" weight="fill" />Windows 10 and 11</li>
      <li><Icon name="apple-logo" weight="fill" />macOS 15</li>
      <li><Icon name="linux-logo" weight="fill" />Linux</li>
      <li><Icon name="android-logo" weight="fill" />Android 8, tablets, TV</li>
      <li><Icon name="device-mobile" weight="fill" />iOS 26</li>
    </ul>
  </div>

  <!-- 2.0: the Mac's look on every system, in six rules. -->
  <section id="new" class="look" aria-labelledby="look-title">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 id="look-title">One look, <span class="em">everywhere.</span></h2>
        <p>Needle 2.0 takes the calm look of the Mac app to Windows, Linux, Android, and iPhone. The same six rules, on every screen.</p>
      </div>
      <div class="look-pair" data-reveal>
        <figure class="frame look-desk">
          <Image src={winAlbums} widths={[720, 1080, 1396]} sizes="(max-width: 900px) 94vw, 860px" loading="lazy" alt="Needle 2.0 on Windows: the album grid with soft covers, and the queue floating beside it." />
        </figure>
        <figure class="phone look-phone">
          <Image src={phoneHome} widths={[300, 600]} sizes="280px" loading="lazy" alt="Needle 2.0 on Android: Home with a greeting, the song playing, and shelves of albums, over a floating dock." />
        </figure>
      </div>
      <ol class="rules" data-reveal>
        {rules.map(([icon, t, d]) => <li><Icon name={icon} class="rule-icon" /><b>{t}</b><span>{d}</span></li>)}
      </ol>
    </div>
  </section>

  <!-- The big player: the visualizer, the waveform seek bar, and lyrics. -->
  <section id="features" class="big" aria-labelledby="big-title">
    <div class="big-glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 id="big-title">Watch the music <span class="em">move.</span></h2>
        <p>Light that moves in the cover's colours. A seek bar in the shape of the song, loud and quiet. Lyrics that light up word by word, with a translation under each line.</p>
      </div>
      <figure class="frame big-shot" data-reveal>
        <Image src={winBig} widths={[720, 1080, 1396]} sizes="(max-width: 1240px) 94vw, 1160px" loading="lazy" alt="Needle's big player: the cover large and soft, the lyrics beside it with the line being sung lit, and a waveform seek bar." />
      </figure>
      <div class="big-points">
        <div class="card big-viz" data-reveal>
          <span class="disc"><Icon name="waveform" /></span>
          <h3>A visualizer</h3>
          <p>In the big player, or across the whole screen for a party or a TV.</p>
          <div class="viz" aria-hidden="true">{wave.slice(0, 40).map((h, i) => <i style={`--h:${h};--i:${i}`}></i>)}</div>
        </div>
        <div class="card" data-reveal>
          <span class="disc"><Icon name="chart-bar" /></span>
          <h3>The song's own shape</h3>
          <svg class="wave" viewBox="0 0 288 40" preserveAspectRatio="none" aria-hidden="true">
            {wave.map((h, i) => <rect x={i * 4} y={20 - h / 2} width="2.2" height={h} rx="1.1" class={i < 30 ? "on" : ""} />)}
          </svg>
          <p>See where the quiet part ends, and jump to the chorus.</p>
        </div>
        <div class="card" data-reveal>
          <span class="disc"><Icon name="translate" /></span>
          <h3>Word by word, in your language</h3>
          <p>Words light up as they are sung. A translation sits under each line.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The other new things, in one grid. -->
  <section class="more" aria-labelledby="more-title">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 id="more-title">More to find in <span class="em">your library.</span></h2>
      </div>
      <div class="bento">
        <article class="card c-crate" data-reveal>
          <span class="disc"><Icon name="vinyl-record" /></span>
          <h3>The record crate</h3>
          <p>Flip through your albums like records in a box.</p>
          <div class="crop"><Image src={winCrate} widths={[900]} sizes="680px" loading="lazy" alt="The record crate: albums stand one behind the other, and the front one shows its cover." /></div>
        </article>

        <article class="card c-mood" data-reveal>
          <span class="disc"><Icon name="circles-four" /></span>
          <h3>The mood map</h3>
          <p>Every song a dot, from calm to lively and dark to bright. Circle an area to play it.</p>
          <svg class="mood" viewBox="0 0 100 100" aria-hidden="true">
            <line x1="50" y1="4" x2="50" y2="96" /><line x1="4" y1="50" x2="96" y2="50" />
            {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.hue} />)}
            <ellipse class="lasso" cx="72" cy="30" rx="18" ry="14" />
          </svg>
          <p class="mood-axes" aria-hidden="true"><span>Calm</span><span>Lively</span></p>
        </article>

        <article class="card c-day" data-reveal>
          <span class="disc"><Icon name="calendar-dots" /></span>
          <h3>On this day</h3>
          <p>A shelf on Home of what you played a year ago, and five.</p>
          <div class="day">
            <figure><img src={cover("bloom-season")} alt="" loading="lazy" /><figcaption>1 year ago</figcaption></figure>
            <figure><img src={cover("single-needle")} alt="" loading="lazy" /><figcaption>5 years ago</figcaption></figure>
          </div>
        </article>

        <article class="card c-mix" data-reveal>
          <span class="disc"><Icon name="metronome" /></span>
          <h3>Smart mixes</h3>
          <p>Crossfades that end on the bar, measured from each song's tempo.</p>
          <svg class="mix" viewBox="0 0 256 64" preserveAspectRatio="none" aria-hidden="true">
            {beats.map((h, i) => <rect x={i * 8} y={32 - h / 2} width="4" height={h} rx="2" class={i < 16 ? "a" : "b"} style={`--i:${i}`} />)}
          </svg>
          <p class="mix-bpm" aria-hidden="true"><span>124 BPM</span><span>124 BPM</span></p>
        </article>

        <article class="card c-card" data-reveal>
          <span class="disc"><Icon name="quotes" /></span>
          <h3>Lyric cards</h3>
          <p>A picture of a line you love, in the cover's colours, ready to share.</p>
          <div class="lyric-card" aria-hidden="true">
            <img src={cover("night-ferry")} alt="" loading="lazy" />
            <b>“Put the needle down again”</b>
            <small>Last Crossing · Oda Lind</small>
          </div>
        </article>

        <article class="card c-numbers" data-reveal>
          <span class="disc"><Icon name="chart-pie-slice" /></span>
          <h3>Your library in numbers</h3>
          <p>Formats, hi-res share, decades, genres, and the albums still missing a cover.</p>
          <div class="crop"><Image src={winNumbers} widths={[900]} sizes="560px" loading="lazy" alt="Your library: 38 songs, 12 albums, 10 artists, 100% lossless, and bars for formats and decades." /></div>
        </article>

        <article class="card c-buttons" data-reveal>
          <span class="disc"><Icon name="sliders" /></span>
          <h3>Choose the player's buttons</h3>
          <p>Drag the buttons you want into the player, in your order. On Android, the notification follows.</p>
          <div class="crop"><Image src={winButtons} widths={[900]} sizes="680px" loading="lazy" alt="The Player buttons setting: the player drawn small, with buttons to drag in or out." /></div>
        </article>

        <article class="card c-artists" data-reveal>
          <span class="disc"><Icon name="users-three" /></span>
          <h3>Artists, sorted properly</h3>
          <p>Sort tags, accents, and “feat.” done right; an A to Z bar; a picture for every artist, or your own photo, banner, and logo.</p>
          <div class="crop"><Image src={winArtists} widths={[900]} sizes="620px" loading="lazy" alt="Artists in circles, with A to Z, Most played, Most songs, Newest, and Only album artists above them." /></div>
        </article>

        <article class="card c-fonts" data-reveal>
          <span class="disc"><Icon name="text-aa" /></span>
          <h3>Your fonts</h3>
          <p>Eight fonts for titles and five for text, or one on your own computer.</p>
          <p class="font-big" aria-hidden="true">Aa</p>
          <ul class="font-list" aria-hidden="true">
            <li style="font-family: var(--sans); font-weight: 600">Good evening</li>
            <li style="font-family: var(--serif)">Good evening</li>
            <li style="font-family: var(--mono)">Good evening</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Android. -->
  <section id="android" class="phones-sec" aria-labelledby="android-title">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 id="android-title">The same Needle, <span class="em">in your pocket.</span></h2>
        <p>Plain rows, soft corners, and one floating dock for the player and the tabs. On phones, tablets, and TVs.</p>
      </div>
      <div class="android-split">
      <div class="phones" data-phones>
        <figure class="phone p-left"><Image src={phoneAlbum} widths={[300, 600]} sizes="(max-width: 767px) 40vw, 280px" loading="lazy" alt="An album page on Android, in the colours of its cover." /></figure>
        <figure class="phone p-mid"><Image src={phonePlayer} widths={[340, 680]} sizes="(max-width: 767px) 50vw, 320px" loading="lazy" alt="Needle's player on Android, with the waveform seek bar and the player's buttons." /></figure>
        <figure class="phone p-right"><Image src={phoneLyrics} widths={[300, 600]} sizes="(max-width: 767px) 40vw, 280px" loading="lazy" alt="Lyrics on Android, the line being sung lit, with Translate above them." /></figure>
      </div>
      <ul class="points" data-reveal>
        <li><Icon name="usb" /><div><h3>Needle's own USB driver</h3><p>With Bit-perfect USB on, Needle talks to your DAC itself: every rate it offers, and DSD.</p></div></li>
        <li><Icon name="bell-ringing" /><div><h3>Your buttons, everywhere</h3><p>The buttons you chose show in the notification, too.</p></div></li>
        <li><Icon name="television-simple" /><div><h3>Tablets and TVs</h3><p>A sidebar like the Mac's, which folds to icons on a TV.</p></div></li>
      </ul>
      </div>
    </div>
  </section>

  <!-- Everything else, in four groups. -->
  <section class="specs" aria-labelledby="specs-title">
    <div class="wrap">
      <div class="head head-left" data-reveal>
        <h2 id="specs-title">Sound, done <span class="em">properly.</span></h2>
      </div>
      <div class="groups">
        <div class="group group-formats" data-reveal>
          <h3>Every format you have</h3>
          <ul class="chips">{formats.map((f) => <li>{f}</li>)}</ul>
        </div>
        {groups.map((g) => (
          <div class="group" data-reveal>
            <Icon name={g.icon} class="group-icon" />
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Privacy, on paper. -->
  <section id="private" class="privacy" aria-labelledby="private-title">
    <div class="wrap">
      <div class="head head-left" data-reveal>
        <p class="eyebrow left">Privacy</p>
        <h2 id="private-title">Yours stays <span class="em">yours.</span></h2>
      </div>
      <ul class="facts" data-reveal>
        <li><Icon name="user-circle-minus" /><b>No account.</b><p>Needle works without one, and keeps your library on your computer.</p></li>
        <li><Icon name="globe-simple" /><b>Lookups stay off until you turn them on.</b><p>Then Needle sends only the artist, album, and title, to find lyrics and covers.</p></li>
        <li><Icon name="folder-lock" /><b>Your files stay as they are.</b><p>Needle changes a file only when you ask, and keeps a backup when it does.</p></li>
        <li><Icon name="arrows-clockwise" /><b>One question a day.</b><p>Needle asks whether a newer version is out. You can turn that off.</p></li>
      </ul>
      <p class="privacy-more"><a class="link" href="/privacy">Read the privacy policy <Icon name="arrow-right" weight="bold" /></a></p>
    </div>
  </section>

  <!-- Download: one tab for each kind of device. -->
  <section id="download" class="download" aria-labelledby="download-title" data-download>
    <div class="halo halo-low" aria-hidden="true"></div>
    <div class="wrap">
      <div class="dl-head" data-reveal>
        <div class="dl-icon"><Logo /></div>
        <h2 id="download-title">Get <span class="em">Needle.</span></h2>
        <p>Free, with no account. The computer apps update themselves.</p>
      </div>

      <div class="dl-tabs" role="tablist" aria-label="Choose your device">
        {platforms.map((p, i) => (
          <button class="dl-tab" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={p.id}>
            <Icon name={p.icon} weight="fill" /><span>{p.name}</span>
          </button>
        ))}
        <span class="dl-tab-pill" aria-hidden="true" data-tab-pill></span>
      </div>

      <div class="dl-panels">
        <!-- Windows -->
        <div class="dl-panel" role="tabpanel" id="panel-windows" aria-labelledby="tab-windows" data-panel="windows">
          <figure class="frame device"><Image src={winHome} widths={[720, 1080]} sizes="(max-width: 900px) 94vw, 620px" loading="lazy" alt="Needle on Windows." /></figure>
          <div class="dl-info">
            <h3>Needle for Windows</h3>
            <p class="dl-meta">Version <span data-version="main">{version}</span> · Windows 10 and 11, 64-bit</p>
            <div class="dl-buttons">
              <a class="btn btn-primary" href={href("setup")} data-asset="setup"><Icon name="download-simple" weight="bold" />Download the installer</a>
              <a class="btn btn-quiet" href={href("zip")} data-asset="zip">Portable zip</a>
            </div>
            <p class="dl-note">The installer needs no administrator. The zip runs from any folder, with nothing to install. <span class="dl-size"><span data-size="setup">{size("setup")}</span> and <span data-size="zip">{size("zip")}</span>.</span></p>
          </div>
        </div>

        <!-- Mac -->
        <div class="dl-panel" role="tabpanel" id="panel-mac" aria-labelledby="tab-mac" data-panel="mac" hidden>
          <figure class="frame device"><Image src={appMac} widths={[720, 1080]} sizes="(max-width: 900px) 94vw, 620px" loading="lazy" alt="Needle 2.0 on a Mac: Home with the song playing, Jump back in, and New in your library." /></figure>
          <div class="dl-info">
            <h3>Needle for Mac</h3>
            <p class="dl-meta">Version <span data-version="mac">{macVersion}</span> · Apple silicon (M1 or newer), macOS 15 or newer</p>
            <p class="dl-step">Paste this into Terminal, then press Return:</p>
            <div class="command">
              <code data-command>curl -fsSL https://needle.nnx.fyi/install-mac.sh | bash</code>
              <button class="copy" type="button" data-copy aria-label="Copy the command"><Icon name="copy" /><span data-copy-label>Copy</span></button>
            </div>
            <p class="dl-note">It downloads Needle, checks it against the published checksum, and puts it in Applications.</p>
            <div class="dl-buttons">
              <a class="btn btn-quiet" href={href("dmg")} data-asset="dmg"><Icon name="download-simple" weight="bold" />Or the disk image (.dmg)</a>
            </div>
            <p class="dl-note">Needle is not signed by Apple, so macOS holds back a downloaded disk image the first time. <a href="/help#install">Help explains how to open it.</a> <span class="dl-size" data-size="dmg">{size("dmg")}</span></p>
          </div>
        </div>

        <!-- Linux -->
        <div class="dl-panel" role="tabpanel" id="panel-linux" aria-labelledby="tab-linux" data-panel="linux" hidden>
          <figure class="frame device"><Image src={winAlbums} widths={[720, 1080]} sizes="(max-width: 900px) 94vw, 620px" loading="lazy" alt="Needle on Linux." /></figure>
          <div class="dl-info">
            <h3>Needle for Linux</h3>
            <p class="dl-meta">Version <span data-version="main">{version}</span> · Ubuntu 24.04, Mint 22, Debian 13, Fedora 40, and newer, 64-bit</p>
            <div class="dl-buttons">
              <a class="btn btn-primary" href={href("deb")} data-asset="deb"><Icon name="download-simple" weight="bold" />Ubuntu, Mint, Debian</a>
              <a class="btn btn-quiet" href={href("rpm")} data-asset="rpm"><Icon name="download-simple" weight="bold" />Fedora, openSUSE</a>
            </div>
            <p class="dl-note">The first is a .deb package, the second an .rpm package. Open it with your software installer. <span class="dl-size"><span data-size="deb">{size("deb")}</span> and <span data-size="rpm">{size("rpm")}</span>.</span></p>
          </div>
        </div>

        <!-- Android -->
        <div class="dl-panel" role="tabpanel" id="panel-android" aria-labelledby="tab-android" data-panel="android" hidden>
          <figure class="phone device device-phone"><Image src={phonePlayer} widths={[300, 600]} sizes="260px" loading="lazy" alt="Needle's player on an Android phone." /></figure>
          <div class="dl-info">
            <h3>Needle for Android</h3>
            <p class="dl-meta">Version <span data-version="android">{androidVersion}</span> · Android 8.0 and newer</p>
            <div class="dl-buttons">
              <a class="btn btn-primary" href={href("apkArm")} data-asset="apkArm"><Icon name="download-simple" weight="bold" />For most phones</a>
              <a class="btn btn-quiet" href={href("apkX86")} data-asset="apkX86">For Intel and AMD devices</a>
            </div>
            <p class="dl-note">Most phones and tablets need the first one (ARM64). The second (x86_64) is for devices with Intel or AMD chips, and for emulators. Open the downloaded file to install it. Older TVs with a 32-bit chip need <a href={href("apkArm7")} data-asset="apkArm7">the 32-bit one (ARMv7)</a>. <span class="dl-size"><span data-size="apkArm">{size("apkArm")}</span> each.</span></p>
          </div>
        </div>

        <!-- iPhone: through SideStore or AltStore, which sign it with the person's own Apple ID. -->
        <div class="dl-panel" role="tabpanel" id="panel-iphone" aria-labelledby="tab-iphone" data-panel="iphone" hidden>
          <figure class="phone device device-phone"><Image src={shotIphone} widths={[300, 600]} sizes="260px" loading="lazy" alt="Needle 2.0 on an iPhone: the player with its cover across the screen and the waveform seek bar." /></figure>
