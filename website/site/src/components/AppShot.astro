---
// Real pictures of Needle on a computer, where AppWindow drew one: a single picture, or
// several in the same place that take turns (one shows at a time; scripts/home.ts picks it by
// `data-shot`). They come from a made-up library (the albums in lib/albums.js, silent files,
// made-up plays), so they show nothing of anyone's own music.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Shot { src: ImageMetadata; key: string }
// `eager`: load every picture at once (above the fold, and the next ones must be ready to
// fade in when their turn comes).
interface Props { shots: Shot[]; class?: string; label: string; eager?: boolean }
const { shots, class: cls = "", label, eager = false } = Astro.props;
---
<div class={`app-shot ${cls}`} role="img" aria-label={label} data-app-shot>
  {shots.map((s, i) => (
    <Image
      src={s.src}
      alt=""
      widths={[720, 1080, 1424]}
      sizes="(max-width: 1240px) 94vw, 1180px"
      loading={eager ? "eager" : "lazy"}
      class={i === 0 ? "on" : undefined}
      data-shot={s.key}
    />
  ))}
</div>
