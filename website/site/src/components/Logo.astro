---
// Needle 2.0's icon, "Glass groove": the amber record as glass with a soft glow behind it, the
// cream tonearm, on a charcoal squircle. The same drawing as assets/icon/needle.svg
// (scripts/make-icon.py). `plate={false}` leaves the squircle out; `grooves={false}` is for
// small sizes. Each copy gets its own ids, so several can sit on one page.
interface Props { class?: string; plate?: boolean; grooves?: boolean }
const { class: cls = "", plate = true, grooves = true } = Astro.props;
const id = `n${Math.random().toString(36).slice(2, 8)}`;
const [cx, cy, r] = [236, 288, 150];
const [px, py, ex, ey] = [cx + 184, cy - 190, cx + 82, cy - 64];
---
<svg class={`logo ${cls}`} viewBox="0 0 512 512" aria-hidden="true">
  <defs>
    <filter id={`${id}sh`} x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#000" flood-opacity=".35" /></filter>
    <linearGradient id={`${id}bg`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2d2926" /><stop offset="1" stop-color="#141211" /></linearGradient>
    <radialGradient id={`${id}d`} cx=".36" cy=".3" r=".85"><stop offset="0" stop-color="#f6d9a4" /><stop offset=".55" stop-color="#e2b46c" /><stop offset="1" stop-color="#ad7a3c" /></radialGradient>
    <linearGradient id={`${id}s`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".6" /><stop offset=".42" stop-color="#fff" stop-opacity="0" /></linearGradient>
    <radialGradient id={`${id}g`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#e2b46c" stop-opacity=".5" /><stop offset="1" stop-color="#e2b46c" stop-opacity="0" /></radialGradient>
  </defs>
  {plate && <rect width="512" height="512" rx="115" fill={`url(#${id}bg)`} />}
  {plate && <rect x="2" y="2" width="508" height="508" rx="113" fill="none" stroke="#fff" stroke-opacity=".09" stroke-width="3" />}
  <g class="logo-record">
    <circle cx={cx} cy={cy} r={r * 1.45} fill={`url(#${id}g)`} />
    <circle cx={cx} cy={cy} r={r} fill={`url(#${id}d)`} />
    {grooves && [.86, .74, .62].map((k) => <circle cx={cx} cy={cy} r={r * k} fill="none" stroke="#7a5020" stroke-opacity=".35" stroke-width={r * .02} />)}
    <circle cx={cx} cy={cy} r={r} fill={`url(#${id}s)`} opacity=".55" />
    <circle cx={cx} cy={cy} r={r} fill="none" stroke="#fff" stroke-opacity=".25" stroke-width="2" />
    <circle cx={cx} cy={cy} r={r * .36} fill="#1b1816" />
    <circle cx={cx} cy={cy} r={r * .08} fill="#e2b46c" />
  </g>
  <g class="logo-arm" filter={`url(#${id}sh)`}>
    <line x1={px} y1={py} x2={ex} y2={ey} stroke="#f2e8d6" stroke-width="22" stroke-linecap="round" />
    <circle cx={px} cy={py} r="30" fill="#f2e8d6" />
    <circle cx={px} cy={py} r="12" fill="#1b1816" />
  </g>
</svg>
